# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# --- Mid-Side mixing frontend ---
# API origin only — src/mixing/lib/api.js appends /mixing/api.
VITE_API_BASE=http://localhost:3001
VITE_LEAD_ENGINEER_PHONE=+234 800 000 0000
# WhatsApp number (digits with country code; spaces/+ ok — stripped for wa.me)
VITE_WHATSAPP_NUMBER=+234 800 000 0000
# YouTube watch or embed URL shown above the /mixing signup form (omit to hide)
# VITE_MIXING_INTRO_YOUTUBE_URL=https://www.youtube.com/watch?v=VIDEO_ID
VITE_STEMS_EMAIL=stems@example.com
# Optional fallback if Firebase battleMusicUrl is empty
# VITE_MIXING_MUSIC_URL=https://example.com/kemena-track.mp3

# Live (also in .env.production):
# VITE_API_BASE=https://magenta-rhinoceros-715254.hostingersite.com
# VITE_MIXING_INTRO_YOUTUBE_URL=https://www.youtube.com/watch?v=VIDEO_ID
# VITE_WHATSAPP_NUMBER=+234XXXXXXXXXX
